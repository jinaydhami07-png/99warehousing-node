# Patterns follow .gitignore rules: WITHOUT a leading slash a name matches at
# ANY depth. That is exactly how this file once broke the deployment — a bare
# "app.js" also matched server/src/app.js, the Express application itself, and
# every API request failed with "Cannot find module '../server/src/app'".
# Anchor anything meant for the root only.

# The cPanel/Passenger entry point, at the repo root only. Vercel uses
# api/index.js instead, and this file calls app.listen(), which serverless
# never runs.
/app.js

# Apache rules, wherever they are. Vercel ignores .htaccess; its routing is in
# vercel.json.
.htaccess

# Not needed at runtime.
/server/.env.example
/README.md
