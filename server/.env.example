# ═══════════════════════════════════════════════════════════════
#  BPSF API — environment configuration
#  ───────────────────────────────────────────────────────────────
#  SETUP:  cp .env.example .env    then fill in the values below.
#
#  ⚠  .env must NEVER be committed. It is already in .gitignore.
#     Only this .example file — with placeholders, no real values —
#     belongs in version control.
#
#  In production do not ship a .env file at all: inject these as real
#  environment variables via your platform's secret manager
#  (AWS Secrets Manager, Vercel/Render env vars, Kubernetes Secrets).
# ═══════════════════════════════════════════════════════════════


# ── APPLICATION ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Max request body size. Keep this small — it is a DoS control.
# Raise it per-route for uploads, not globally.
BODY_LIMIT=100kb

# Number of reverse proxies in front of this app (nginx, ALB, Cloudflare).
#   0 = running directly, no proxy
#   1 = one proxy
# Never set this to `true`: that trusts a client-supplied X-Forwarded-For
# header, letting an attacker spoof their IP and bypass rate limiting.
TRUST_PROXY=0

LOG_LEVEL=info


# ── DATABASE ───────────────────────────────────────────────────
# WHERE: https://cloud.mongodb.com
#   Cluster → "Connect" → "Drivers" → copy the string.
#   Replace <password> with your database user's password.
#   URL-encode any of  : / ? # [ ] @  that appear in the password.
#   Under "Network Access", allow your server's IP.
#
# Local alternative:  mongodb://127.0.0.1:27017/bpsf
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bpsf?retryWrites=true&w=majority

# Connection pool. One pool is shared by the whole process — the driver
# multiplexes all queries across these sockets. Rule of thumb: start at 10
# and raise only if you observe waitQueue timeouts under load. Too high
# exhausts the database's own connection limit.
MONGO_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2


# ── CORS ───────────────────────────────────────────────────────
# Comma-separated allow-list of browser origins. No trailing slashes.
# NEVER use "*" here — combined with credentials:true it would let any
# site on the internet make authenticated requests as your users.
# The app refuses to boot with "*" when NODE_ENV=production.
CORS_ORIGINS=http://localhost:5000,http://localhost:5173


# ── AUTHENTICATION ─────────────────────────────────────────────
# Generate two DIFFERENT values:
#     node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 32 characters is enforced in production.
# Rotating these invalidates all existing sessions — which is exactly what
# you want if one is ever exposed.
JWT_ACCESS_SECRET=<paste-64-byte-hex-here>
JWT_REFRESH_SECRET=<paste-a-DIFFERENT-64-byte-hex-here>

# Short access token, longer refresh token. Keep the access token minutes,
# not hours: it is the window an attacker gets from a leaked token.
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# bcrypt work factor. 12 ≈ 250ms per hash on modern hardware — slow enough
# to make offline cracking expensive, fast enough for interactive login.
# Raise as hardware improves; every +1 doubles the cost.
BCRYPT_ROUNDS=12


# ── RATE LIMITING ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MIN=15

# Requests per window per IP across the whole API.
RATE_LIMIT_MAX=300

# Failed attempts per window on /auth/login and /auth/register.
# This is the brute-force control — keep it low.
AUTH_RATE_LIMIT_MAX=10


# ── OPTIONAL ───────────────────────────────────────────────────
# Passkey for the admin dashboard. Change before production.
# ⚠ NEVER put the real passkey in this file. This template is committed, so
# anything written here is published with the repository. Set the real value
# in .env (which is gitignored). The server refuses to start in production if
# this placeholder is left in place.
ADMIN_PASSKEY=<choose-a-long-random-staff-passkey>

# ── GOOGLE SIGN-IN (optional) ──────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials →
# "Create credentials" → OAuth client ID → Web application.
#
# Add the callback below to that client's "Authorised redirect URIs".
# It must match exactly — scheme, host, port and path.
#
# ⚠ Placeholders only. This file is committed; real values go in .env.
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-client-secret>
GOOGLE_CALLBACK_URL=https://99warehousing.com/api/v1/auth/google/callback

# ── MEDIA STORAGE ──────────────────────────────────────────────
# Where property photos and floor plans are kept.
#
#   mongo → everything in MongoDB. The AWS settings below are ignored, so
#           they can be filled in ahead of being switched on.
#   auto  → S3 when AWS_S3_BUCKET + AWS_REGION are set, MongoDB otherwise.
#   s3    → require S3; refuse to start without a bucket, so a production
#           box cannot quietly fall back to filling the database.
#
# Either way images are sniffed, EXIF-rotated, stripped of metadata and
# re-encoded to WebP at every width in MEDIA_WIDTHS, and the pages get a
# real srcset. MongoDB serves them from /api/v1/images/:id?w=320; S3 serves
# them from the bucket, ideally through a CDN. What S3 buys is the CDN and
# not having image bytes in the database — not the resizing, which happens
# regardless.
MEDIA_DRIVER=auto

# ── AWS S3 (used when MEDIA_DRIVER is auto or s3) ──────────────
# Property photos and floor plans are stored in S3; MongoDB keeps only the
# text — captions, dimensions and the URLs pointing at these objects.
#
# Leave AWS_S3_BUCKET blank and uploads fall back to storing the bytes in
# MongoDB, which is how this app used to work. That still runs, but every
# image read then costs a database query and the 16 MB document ceiling and
# Atlas storage tier become the limit on how many photos the site can hold.
#
# Setting it up:
#   1. S3 → Create bucket. Block Public Access ON, ACLs disabled (defaults).
#   2. CloudFront → Create distribution, origin = that bucket, and let the
#      wizard create the Origin Access Control. This is what serves the
#      images publicly without the bucket itself being public.
#   3. IAM → a user or role with s3:PutObject, s3:DeleteObject, s3:GetObject
#      on arn:aws:s3:::<bucket>/* and nothing else.
#
# ⚠ Placeholders only. This file is committed; real values go in .env.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=<your-bucket-name>

# Omit both on EC2/ECS/Lightsail — the SDK uses the instance role instead,
# which beats long-lived keys sitting in a file on disk.
AWS_ACCESS_KEY_ID=<your-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>

# CloudFront domain in front of the bucket. Without it, URLs point straight
# at S3: still works, but slower and billed at the S3 egress rate.
AWS_S3_PUBLIC_BASE_URL=https://dxxxxxxxxxxxxx.cloudfront.net

# Key prefix, so one bucket can hold staging and production side by side.
AWS_S3_PREFIX=media

# Only for a pre-2023 bucket served direct from S3 with ACLs still enabled.
# Modern buckets reject any request carrying an ACL — leave this unset.
# AWS_S3_ACL=public-read

# Widths generated per upload. The browser picks one out of the srcset, so a
# phone never downloads the 1920px file.
MEDIA_WIDTHS=320,640,1280,1920
MEDIA_WEBP_QUALITY=78
