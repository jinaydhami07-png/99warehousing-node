{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteOwnTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/99w_*",
        "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/99w_*/index/*"
      ]
    }
  ]
}
