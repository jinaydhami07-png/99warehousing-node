{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateOwnTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:UpdateTimeToLive",
        "dynamodb:TagResource"
      ],
      "Resource": [
        "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/99w_*",
        "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/99w_*/index/*"
      ]
    },
    {
      "Sid": "ListTablesIsAccountWide",
      "Effect": "Allow",
      "Action": ["dynamodb:ListTables"],
      "Resource": "*"
    }
  ]
}
