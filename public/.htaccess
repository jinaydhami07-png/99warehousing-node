# ─────────────────────────────────────────────────────────────────────────
# 99Warehousing — public_html
#
# Apache serves the static site. It does NOT serve the API.
#
# The API cannot run on this host: GoDaddy's shared hosting enforces an
# outbound port allowlist (80, 443 and 2096 are open; 27017 is not), so a
# Node process here can never reach MongoDB Atlas. Measured against a
# third-party port responder, with port 80 as a passing control — the
# symptom is identical to a wrong IP in the Atlas access list, so test the
# port before blaming Atlas.
#
# The API therefore runs on Vercel, which can reach Atlas, and the pages
# call it across origins. The host the pages call is PROD_API_HOST in
# assets/api.js — the single place that knows where the API lives.
#
# An earlier version of this file proxied /api/* to Node on 127.0.0.1:5050.
# That block is gone: it could only ever answer 503 here.
# ─────────────────────────────────────────────────────────────────────────

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── https ──────────────────────────────────────────────────────────────
  # Both conditions are needed: %{HTTPS} is the signal when Apache itself
  # terminates TLS, and X-Forwarded-Proto is the signal if a CDN is ever put
  # in front. Testing only the first would redirect forever behind a CDN.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # ── Security ───────────────────────────────────────────────────────────
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

  # No includeSubDomains: cpanel, webdisk and mail are siblings of this
  # domain and are not ours to force onto HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"

  # script-src-attr is listed separately because the pages use inline
  # onclick/onchange handlers; in CSP3 'unsafe-inline' in script-src alone
  # does not cover attribute handlers, and omitting it kills every button.
  #
  # The API origin appears in connect-src and img-src because the API is
  # off-domain (see the header of this file) and listing images are served
  # from it. Both the current Vercel host and the api subdomain are listed
  # so that moving to the subdomain is a one-line change in api.js.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; script-src-attr 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://99warehousing.vercel.app https://api.99warehousing.com; connect-src 'self' https://99warehousing.vercel.app https://api.99warehousing.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"

  # ── Caching ────────────────────────────────────────────────────────────
  # Hashed and versioned assets may be cached hard; the HTML that references
  # them must not be, or a deploy ships new assets to pages still asking for
  # the old ones.
  <FilesMatch "\.(css|js|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# Correct types, in case the host's defaults are incomplete — a stylesheet
# served as text/plain is ignored by every browser, which is one way the CSS
# on this site has gone missing before.
<IfModule mod_mime.c>
  AddType text/css                  .css
  AddType application/javascript    .js
  AddType image/svg+xml             .svg
  AddType image/webp                .webp
  AddType font/woff2                .woff2
  AddType application/json          .json
</IfModule>

# Never serve dotfiles: .env, .git and friends are plain text to Apache.
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
