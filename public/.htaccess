# ─────────────────────────────────────────────────────────────────────────
# 99Warehousing — public_html
#
# Apache serves the static site and forwards only /api/* to the Node process
# on a local port.
#
# Why the API can run here at all: this host enforces an outbound port
# allowlist — 80, 443 and 2096 are open, 27017 is not — so Node here can
# never reach MongoDB. It reaches DynamoDB, which speaks HTTPS on 443. That
# is the whole reason the data store moved.
#
# Apache serves the pages rather than proxying them. Nothing supervises a
# process on shared hosting, so a backend that dies must not take the
# website with it: with Node stopped, pages and assets still return 200 and
# only /api degrades.
#
# Rollback is removing the "API → Node" block. Apache then serves the site
# exactly as it did before Node existed.
# ─────────────────────────────────────────────────────────────────────────

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── https ──────────────────────────────────────────────────────────────
  # Both conditions are needed: %{HTTPS} is the signal when Apache itself
  # terminates TLS, and X-Forwarded-Proto is the signal if a CDN is ever put
  # in front. Testing only the first would redirect forever behind a CDN.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # ── API → Node ─────────────────────────────────────────────────────────
  # [P] hands the request to mod_proxy. The port here must match PORT in
  # server/env; if they disagree every API call returns 502 while the rest
  # of the site looks perfectly healthy.
  RewriteRule ^api/(.*)$ http://127.0.0.1:5050/api/$1 [P,QSA,L]
</IfModule>

<IfModule mod_headers.c>
  # mod_proxy forwards X-Forwarded-For and X-Forwarded-Host on its own but
  # not the protocol, so without this Express sees a plain http request and
  # req.protocol reports the wrong scheme behind TLS.
  RequestHeader set X-Forwarded-Proto "https" env=HTTPS

  # ── Security ───────────────────────────────────────────────────────────
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

  # No includeSubDomains: cpanel, webdisk and mail are siblings of this
  # domain and are not ours to force onto HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"

  # script-src-attr is listed separately because the pages use inline
  # onclick/onchange handlers; in CSP3 'unsafe-inline' in script-src alone
  # does not cover attribute handlers, and omitting it kills every button.
  #
  # connect-src is 'self' again now that the API is same-origin. Listing
  # photos come from the S3 bucket, which is why that host is in img-src:
  # DynamoDB caps an item at 400KB, so image bytes cannot live beside the
  # listing data the way they did in MongoDB.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; script-src-attr 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://99warehousing-media-apse2.s3.ap-southeast-2.amazonaws.com; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"

  # ── Caching ────────────────────────────────────────────────────────────
  # Hashed and versioned assets may be cached hard; the HTML that references
  # them must not be, or a deploy ships new assets to pages still asking for
  # the old ones.
  <FilesMatch "\.(css|js|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# Correct types, in case the host's defaults are incomplete — a stylesheet
# served as text/plain is ignored by every browser, which is one way the CSS
# on this site has gone missing before.
<IfModule mod_mime.c>
  AddType text/css                  .css
  AddType application/javascript    .js
  AddType image/svg+xml             .svg
  AddType image/webp                .webp
  AddType font/woff2                .woff2
  AddType application/json          .json
</IfModule>

# Never serve dotfiles: .env, .git and friends are plain text to Apache.
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
